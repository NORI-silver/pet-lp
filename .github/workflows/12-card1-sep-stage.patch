 FC_IC = {"pin": "📍", "clock": "🕒", "car": "🚗", "yen": "¥", "paw": "🐾", "badge": "🏅"}
 
 
+# --- 共通の行（住所・時間・料金・対応・口コミ。カテゴリ固有の行はその下に残す）---
+STD_LAB = {"📍": "住所", "🕒": "時間", "¥": "料金", "🐾": "対応"}
+STD_ORDER = ["住所", "時間", "料金", "対応"]
+
+
+def _std_rows(b, a0):
+    """カードの本文 b の中のアイコン行を、固定の順番（住所・時間・料金・対応・口コミ）に並べ直す。
+    値が無いものは「未確認」（データに無いだけで、無いとは言わない）。ほかの行は消さずに下へ回す。
+    住所は data-to、対応は data-fit の at（施設のデータ）で補う。"""
+    rows = re.findall(r'<p class="ux-c-l cs-l[^"]*"><i aria-hidden="true">(.*?)</i><span>(.*?)</span></p>', b, flags=re.S)
+    if not rows: return b
+    got, extra = {}, []
+    for ic, body in rows:
+        lab = STD_LAB.get(ic)
+        if lab and lab not in got: got[lab] = body
+        else: extra.append((lab or ("場所" if ic in ("🗺", "・") else ic), body, ic))
+    to = a0.get("data-to", "")
+    if "住所" not in got and to: got["住所"] = _html.escape(to)
+    if "対応" not in got:
+        try: at = json.loads(_html.unescape(a0.get("data-fit", "{}"))).get("at", "")
+        except Exception: at = ""
+        if at: got["対応"] = _html.escape(at)
+    out = []
+    for lab in STD_ORDER:
+        v = got.get(lab)
+        out.append(f'<p class="ux-c-l cs-l cs-s{" cs-u" if not v else ""}"><b class="cs-k">{lab}</b><span>{v or "未確認"}</span></p>')
+    out.append('<p class="ux-c-l cs-l cs-s cs-u"><b class="cs-k">口コミ</b><span>未連携</span></p>')
+    for lab, body, ic in extra:
+        if lab in ("🏅", "🚗", "📋", "🏠", "🐈", "🐕"): out.append(f'<p class="ux-c-l cs-l"><i aria-hidden="true">{lab}</i><span>{body}</span></p>')
+        else: out.append(f'<p class="ux-c-l cs-l cs-s"><b class="cs-k">{lab}</b><span>{body}</span></p>')
+    first = re.search(r'<p class="ux-c-l cs-l', b)
+    last = list(re.finditer(r'<p class="ux-c-l cs-l[^"]*"><i aria-hidden="true">.*?</i><span>.*?</span></p>', b, flags=re.S))[-1]
+    # 行の間に他の要素がある場合は、最初の行の位置に新しい並びを入れ、元の行は取り除く
+    nb = b
+    for m in reversed(list(re.finditer(r'<p class="ux-c-l cs-l[^"]*"><i aria-hidden="true">.*?</i><span>.*?</span></p>', b, flags=re.S))):
+        nb = nb[:m.start()] + nb[m.end():]
+    return nb[:first.start()] + "".join(out) + nb[first.start():]
+
