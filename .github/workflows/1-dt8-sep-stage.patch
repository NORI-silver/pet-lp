diff --git a/tests/taxi-static-dto.test.cjs b/tests/taxi-static-dto.test.cjs
new file mode 100644
index 000000000..0f17c51c9
--- /dev/null
+++ b/tests/taxi-static-dto.test.cjs
@@ -0,0 +1,20 @@
+// 行き先（data-to）のあるトリミング・トレーナーのカードは、HTMLに料金リンクが最初から1つだけある（読み込み直しのあとでも消えない）
+const fs = require("fs"), path = require("path");
+let cards = 0, bad = [];
+for (const cat of ["dog-trainer", "trimming"]) {
+  const dir = path.join(__dirname, "..", "find-data", cat);
+  for (const f of fs.readdirSync(dir).filter(x => x.endsWith(".json"))) {
+    const s = JSON.stringify(JSON.parse(fs.readFileSync(path.join(dir, f), "utf8")));
+    const re = /<div class=\\"emg-item emg-co fc[^>]*?data-to=\\"[^>]*?>.*?(?=<div class=\\"emg-item|$)/g;
+    let m;
+    while ((m = re.exec(s))) {
+      const b = m[0].split(/<div class=\\"emg-item/)[0];
+      cards++;
+      const n = (b.match(/<a class=\\"emg-taxi fc-a fc-a-car\\"/g) || []).length;
+      if (n !== 1) bad.push(cat + "/" + f + " n=" + n);
+    }
+  }
+}
+if (cards < 10) { console.error("FAIL few data-to cards found: " + cards); process.exit(1); }
+if (bad.length) { console.error("FAIL " + bad.length + " data-to cards without exactly 1 static taxi link: " + bad.slice(0, 5).join(", ")); process.exit(1); }
+console.log("ok data-to cards " + cards + " each with 1 static taxi link");
