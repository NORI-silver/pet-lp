+        det = f'<details class="ux-c-d"><summary>くわしく見る（料金・時間・登録・持ちもの）</summary><dl>{rows}</dl>{route}{more}{_fac_link(e, d)}</details>'
     hd = f'<h3 class="ux-c-n">{e(d["name"])}</h3>' if full else f'<a class="ux-c-n" href="{href(pf)}#{d["id"]}">{e(d["name"])}</a>'
