diff --git a/tests/rojin-national-nsum.test.cjs b/tests/rojin-national-nsum.test.cjs
new file mode 100644
index 000000000..336c62ed9
--- /dev/null
+++ b/tests/rojin-national-nsum.test.cjs
@@ -0,0 +1,22 @@
+// 老犬ホームの全国のページ：条件つきの高い料金（R020・R038・R059）は、金額を条件ぬきで出さず、県のページへ。県のページには全文がある。
+const fs = require("fs"), assert = require("assert");
+const root = __dirname + "/..";
+const pref = { R059: "miyagi", R038: "fukuoka", R020: "aichi" };
+const nat = fs.readFileSync(root + "/rojin-home/index.html", "utf8");
+function card(h, fid) {
+  const i = h.indexOf('data-fid="' + fid + '"'); if (i < 0) return null;
+  const j = h.indexOf('data-fid="', i + 10); return h.slice(i, j < 0 ? h.length : j);
+}
+for (const [fid, p] of Object.entries(pref)) {
+  const pg = fs.readFileSync(root + "/rojin-home/" + p + "/index.html", "utf8");
+  const c = card(pg, fid);
+  assert(c, fid + " 県のページにない");
+  assert(/料金（全文）/.test(c), fid + " 県のページに料金の全文がない");
+  const n = card(nat, fid);
+  if (n) {
+    const y = n.match(/<li class="yen"><b>料金<\/b><span>(.*?)<\/span>/);
+    assert(y && /県のページ/.test(y[1]) && !/[0-9０-９]/.test(y[1]), fid + " 全国のページは条件ぬきの金額を出さない");
+    assert(n.includes('href="/rojin-home/' + p + '/#c-' + fid + '"'), fid + " 県のページへのリンクがない");
+  }
+}
+console.log("ok rojin-national-nsum");
