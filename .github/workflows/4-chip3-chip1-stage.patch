+    if _CE.card_ok([v for l, v, _ in rows if re.search(r"支払", l)]): f.append("カード払い")
     for l, v, _ in rows:
         if re.search(r"駐車", l) and not re.search(r"なし|ありません|^0|ない", v): f.append("駐車場")
