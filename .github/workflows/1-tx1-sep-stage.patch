go){var f=document.getElementById("form");settle();var i=document.getElementById("pref")||f.querySelector("select,input");if(i)i.focus({preventScroll:true})}}if(b)b.addEventListener("click",function(){open(true)});document.addEventListener("click",function(e){var a=e.target.closest&&e.target.closest("a[href]");if(!a)return;var u=a.getAttribute("href");if(u==="#form"||u==="#taxi"){open(true);e.preventDefault();history.replaceState(null,"","#form");return}var m=/^\/?#([A-Za-z][\w-]*)$/.exec(u||"");var t=m&&document.getElementById(m[1]);if(t&&box.contains(t)){box.hidden=false;if(b)b.setAttribute("aria-expanded","true");e.preventDefault();history.replaceState(null,"","#"+m[1]);t.scrollIntoView()}});function chk(){var q=new URLSearchParams(location.search);if(location.hash==="#form"||location.hash==="#taxi"||q.get("pref")||q.get("to")){open(true);return}var id=location.hash.slice(1),t=id&&document.getElementById(id);if(t&&box.contains(t)){box.hidden=false;if(b)b.setAttribute("aria-expanded","true");setTimeout(function(){t.scrollIntoView()},60)}}chk();window.addEventListener("hashchange",chk)});</script></section><!--/PTAXI--><!-- 6. フォーム -->
