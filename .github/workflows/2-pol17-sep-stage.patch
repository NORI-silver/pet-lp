+        if not a: continue
+        url = html.unescape(a.group(1))
+        src = _UNV
+        if cat == "rojin" and ((D.get((re.search(r' data-fid="([^"]+)"', b) or [None, None])[1]) or {}).get("verified") or {}).get("checked"):
