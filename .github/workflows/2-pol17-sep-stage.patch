+            src = f'<small>出典：<a href="{E(url)}" target="_blank" rel="noopener">公式サイト</a>' + (f"（確認日 {E(c)}）" if c else "") + "</small>"
+        g = m.group(0)
+        parts[k] = b.replace(g, g[:-len("</div></details>")] + src + "</div></details>", 1)
+    return "".join(parts)
